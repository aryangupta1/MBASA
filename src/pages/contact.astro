---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — MBASA">
  <div class="min-h-screen bg-ambient grain font-sans">
    <header class="border-b border-black/10 bg-white/70 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" class="inline-flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-xl border border-black/10 bg-white font-display text-sm tracking-tight shadow-[0_1px_0_0_rgba(0,0,0,.04),_0_10px_35px_rgba(1,72,164,.14)]">
            MB
          </span>
          <span class="leading-tight">
            <span class="block font-display text-sm text-brand">MBASA</span>
            <span class="block -mt-0.5 text-xs text-black/60">Contact</span>
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-black/70 md:flex">
          <a class="hover:text-black" href="/about">About</a>
          <a class="hover:text-black" href="/events">Events</a>
          <a class="hover:text-black" href="/publications">Publications</a>
          <a class="hover:text-black" href="/committee">Committee</a>
          <a class="hover:text-black" href="/partners">Partners</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="btn btn-ghost hidden sm:inline-flex" href="/join">Join</a>
          <a class="btn btn-primary" href="/contact">Contact</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-12 md:py-16">
      <h1 class="font-display text-4xl tracking-tight text-brand md:text-5xl">Contact MBASA</h1>
      <p class="mt-4 max-w-2xl text-lg text-black/70">
        Reach out and we’ll route your message to the right stream lead.
      </p>

      <div class="mt-8 grid gap-4 md:grid-cols-12">
        <div class="md:col-span-7">
          <div class="card p-6">
            <h2 class="font-display text-xl tracking-tight text-brand">Send a message</h2>
            <p class="mt-2 text-sm text-black/70">
              For now, the fastest way is email. If you’d like, we can add a proper form integration next.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="mailto:mbasa@university.edu">Email MBASA</a>
              <a class="btn btn-ghost" href="/join">Join a stream</a>
            </div>
            <p class="mt-3 text-xs text-black/55">
              Email: <span class="font-semibold">mbasa@university.edu</span>
            </p>
          </div>
        </div>

        <aside class="md:col-span-5">
          <div class="card p-6">
            <h2 class="font-display text-xl tracking-tight text-brand">Common topics</h2>
            <div class="mt-4 grid gap-3 text-sm text-black/70">
              <a class="card p-4 hover:opacity-90" href="/events">Events + speaker ideas</a>
              <a class="card p-4 hover:opacity-90" href="/publications">Writing + editorial</a>
              <a class="card p-4 hover:opacity-90" href="/partners">Sponsorship + partnerships</a>
              <a class="card p-4 hover:opacity-90" href="/committee">Committee roles</a>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <footer class="border-t border-black/10 bg-white/70">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm text-black/60 md:flex-row md:items-center md:justify-between">
        <p>© MBASA.</p>
        <div class="flex gap-5">
          <a class="text-black/70 hover:text-black" href="/about">About</a>
          <a class="text-black/70 hover:text-black" href="/join">Join</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

