---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — MBASA">
  <div class="min-h-screen bg-ambient grain font-sans">
    <header class="border-b border-black/10 bg-white/70 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" class="inline-flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-xl border border-black/10 bg-white font-display text-sm tracking-tight shadow-[0_1px_0_0_rgba(0,0,0,.04),_0_10px_35px_rgba(1,72,164,.14)]">
            MB
          </span>
          <span class="leading-tight">
            <span class="block font-display text-sm text-brand">MBASA</span>
            <span class="block -mt-0.5 text-xs text-black/60">MBA Student Association</span>
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-black/70 md:flex">
          <a class="hover:text-black" href="/about">About</a>
          <a class="hover:text-black" href="/events">Events</a>
          <a class="hover:text-black" href="/publications">Publications</a>
          <a class="hover:text-black" href="/committee">Committee</a>
          <a class="hover:text-black" href="/partners">Partners</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="btn btn-ghost hidden sm:inline-flex" href="/join">Join</a>
          <a class="btn btn-primary" href="/contact">Contact</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-12 md:py-16">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7">
          <h1 class="font-display text-4xl tracking-tight text-brand md:text-5xl">About MBASA</h1>
          <p class="mt-5 text-lg text-black/70">
            MBASA is a student-led community built to connect the MBA experience — academically, professionally, and socially.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="card p-6">
              <h2 class="font-display text-lg tracking-tight text-brand">Mission</h2>
              <p class="mt-2 text-sm text-black/70">
                Create a digitally connected platform for MBA students and beyond — an “MBA nervous system”.
              </p>
            </div>
            <div class="card p-6">
              <h2 class="font-display text-lg tracking-tight text-brand">What we do</h2>
              <p class="mt-2 text-sm text-black/70">
                Events, publications, buddy matching, and partnerships that make the MBA feel cohesive.
              </p>
            </div>
            <div class="card p-6">
              <h2 class="font-display text-lg tracking-tight text-brand">How we work</h2>
              <p class="mt-2 text-sm text-black/70">
                Clear roles, lightweight governance, and stream leads who keep decisions moving.
              </p>
            </div>
            <div class="card p-6">
              <h2 class="font-display text-lg tracking-tight text-brand">Where we’re going</h2>
              <p class="mt-2 text-sm text-black/70">
                Stronger alumni ties, partner perks, and collaboration with other MBA communities.
              </p>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-primary" href="/join">Join a stream</a>
            <a class="btn btn-ghost" href="/committee">See committee roles</a>
          </div>
        </div>

        <aside class="md:col-span-5">
          <div class="card p-6">
            <h2 class="font-display text-lg tracking-tight text-brand">Idea streams</h2>
            <p class="mt-2 text-sm text-black/70">These are the pillars MBASA is organised around.</p>
            <div class="mt-4 grid gap-3">
              <a class="card p-4 hover:opacity-90" href="/events">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style="background: var(--mbasa-sticky-red);" />
                  <span class="text-sm font-semibold text-black/80">Events</span>
                </div>
              </a>
              <a class="card p-4 hover:opacity-90" href="/publications">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style="background: var(--mbasa-sticky-orange);" />
                  <span class="text-sm font-semibold text-black/80">Publications</span>
                </div>
              </a>
              <a class="card p-4 hover:opacity-90" href="/buddy-system">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style="background: var(--mbasa-sticky-teal);" />
                  <span class="text-sm font-semibold text-black/80">Buddy system</span>
                </div>
              </a>
              <a class="card p-4 hover:opacity-90" href="/partners">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style="background: var(--mbasa-sticky-violet);" />
                  <span class="text-sm font-semibold text-black/80">Partners</span>
                </div>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <footer class="border-t border-black/10 bg-white/70">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm text-black/60 md:flex-row md:items-center md:justify-between">
        <p>© MBASA.</p>
        <div class="flex gap-5">
          <a class="text-black/70 hover:text-black" href="/events">Events</a>
          <a class="text-black/70 hover:text-black" href="/publications">Publications</a>
          <a class="text-black/70 hover:text-black" href="/contact">Contact</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

