---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Events — MBASA">
  <div class="min-h-screen bg-ambient grain font-sans">
    <header class="border-b border-black/10 bg-white/70 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" class="inline-flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-xl border border-black/10 bg-white font-display text-sm tracking-tight shadow-[0_1px_0_0_rgba(0,0,0,.04),_0_10px_35px_rgba(1,72,164,.14)]">
            MB
          </span>
          <span class="leading-tight">
            <span class="block font-display text-sm text-brand">MBASA</span>
            <span class="block -mt-0.5 text-xs text-black/60">Events</span>
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-black/70 md:flex">
          <a class="hover:text-black" href="/about">About</a>
          <a class="hover:text-black" href="/events">Events</a>
          <a class="hover:text-black" href="/publications">Publications</a>
          <a class="hover:text-black" href="/committee">Committee</a>
          <a class="hover:text-black" href="/partners">Partners</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="btn btn-ghost hidden sm:inline-flex" href="/join">Join</a>
          <a class="btn btn-primary" href="/contact">Contact</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-12 md:py-16">
      <h1 class="font-display text-4xl tracking-tight text-brand md:text-5xl">Events</h1>
      <p class="mt-4 max-w-2xl text-lg text-black/70">
        MBASA runs a mix of professional development, networking, and social events — designed to make the MBA experience feel connected.
      </p>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <article class="card overflow-hidden">
          <div class="h-1.5" style="background: var(--mbasa-sticky-green);" />
          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <span class="tag">Career</span>
              <span class="text-xs text-black/50">Coming soon</span>
            </div>
            <h2 class="mt-3 font-display text-lg tracking-tight text-brand">Interview skills clinic</h2>
            <p class="mt-2 text-sm text-black/70">Practical practice, peer feedback, and confidence-building.</p>
          </div>
        </article>

        <article class="card overflow-hidden">
          <div class="h-1.5" style="background: var(--mbasa-sticky-yellow);" />
          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <span class="tag">Social</span>
              <span class="text-xs text-black/50">Coming soon</span>
            </div>
            <h2 class="mt-3 font-display text-lg tracking-tight text-brand">Cohort mixer</h2>
            <p class="mt-2 text-sm text-black/70">A relaxed way to meet people outside your usual circles.</p>
          </div>
        </article>

        <article class="card overflow-hidden">
          <div class="h-1.5" style="background: var(--mbasa-sticky-violet);" />
          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <span class="tag">Network</span>
              <span class="text-xs text-black/50">Coming soon</span>
            </div>
            <h2 class="mt-3 font-display text-lg tracking-tight text-brand">Alumni panel</h2>
            <p class="mt-2 text-sm text-black/70">Real paths, real advice, and a chance to connect.</p>
          </div>
        </article>
      </div>

      <div class="mt-10 card p-6">
        <h2 class="font-display text-xl tracking-tight text-brand">Want to run an event?</h2>
        <p class="mt-2 text-sm text-black/70">
          If you have an idea (speaker, panel, workshop, social), we’ll help you shape it and promote it to the cohort.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/join">Join the Events stream</a>
          <a class="btn btn-ghost" href="/contact">Pitch an idea</a>
        </div>
      </div>
    </main>

    <footer class="border-t border-black/10 bg-white/70">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm text-black/60 md:flex-row md:items-center md:justify-between">
        <p>© MBASA.</p>
        <div class="flex gap-5">
          <a class="text-black/70 hover:text-black" href="/publications">Publications</a>
          <a class="text-black/70 hover:text-black" href="/partners">Partners</a>
          <a class="text-black/70 hover:text-black" href="/contact">Contact</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

